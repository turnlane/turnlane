{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".tsbuild",
    "tsBuildInfoFile": ".tsbuild/tsconfig.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "bun"],
    "paths": {
      "@turnlane/ext-web": ["./src/ext/none.ts"],
      "@turnlane/ext-host": ["./src/ext/host.ts"]
    }
  },
  "include": ["src", "test", "vite.config.ts"],
  "references": [
    {
      "path": "../daemon"
    },
    {
      "path": "../../packages/core"
    }
  ]
}
