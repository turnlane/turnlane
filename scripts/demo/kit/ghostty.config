# 撮影キット: テスト用ユーザーの Ghostty の設定（~/.config/ghostty/config に写す）。デモ動画の場面 (3) 用。
# 配色は Turnlane のダークにそろえる（地 #0E0F11、文字 #E8E9EB）。位置と大きさは README の「ウインドウの置き方」で合わせる
background = 0e0f11
foreground = e8e9eb
cursor-color = e8e9eb
font-size = 13
window-padding-x = 12
window-padding-y = 8
window-width = 80
window-height = 22
window-position-x = 760
window-position-y = 368
macos-titlebar-style = tabs
confirm-close-surface = false
